# Copy this file to `.env` and adjust as needed.

# How many cans MindAR tracks and overlays with 3D art at the same time.
#   1   = one can at a time (fastest, default)
#   2-3 = show multiple cans at once, at the cost of framerate on phones
# Read at dev-server start / build time, so restart `npm run dev` after changing.
# This does NOT touch the target images, so it never triggers `compile:targets`.
VITE_MAX_TRACK=1

# Where MindAR loads the compiled tracking data (targets.mind) from.
# Default is the bundled file; point at a CDN or an alternate target bundle
# per environment without a code change, e.g. https://cdn.example.com/targets.mind
VITE_TARGETS_SRC=/targets.mind
